# ==============================================================================
# MarineShield Backend & Data-Development Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# DO NOT COMMIT ACTUAL SECRETS OR PRODUCTION CREDENTIALS TO VERSION CONTROL
# ==============================================================================

# --- Application Core ---
ENVIRONMENT=development
PROJECT_NAME=MarineShield
API_V1_STR=/api/v1
SECRET_KEY=marineshield_local_dev_insecure_secret_key_change_in_prod
DEBUG=True
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# --- Database & PostGIS Storage (Person 2 & Person 3) ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marineshield_db
POSTGRES_USER=marineshield_user
POSTGRES_PASSWORD=marineshield_dev_pw
POSTGRES_SCHEMA=public
# Computed URL: postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Asynchronous Task Queue & Cache (Person 3) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Pluggable Data Acquisition Adapters (Person 2) ---
# When credentials are empty, system operates in offline/mock simulation mode
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_AUTH_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_ODATA_URL=https://catalogue.dataspace.copernicus.eu/odata/v1/Products

GFW_API_TOKEN=
GFW_API_BASE_URL=https://gateway.api.globalfishingwatch.org/v3/

INCOIS_API_BASE_URL=https://incois.gov.in/

# --- Mock & Offline Development Flags ---
ALLOW_MOCK_FALLBACK=True
MOCK_AIS_ENABLED=True
MOCK_SAR_ENABLED=True

# --- Filesystem & Storage Paths (Person 1, 2, 3) ---
DATA_ROOT_DIR=data
SAR_RAW_DIR=data/sar_raw
SAR_PREPROCESSED_DIR=data/sar_preprocessed
MODEL_REGISTRY_DIR=models
PYGNOME_OUTPUT_DIR=data/simulations
GIS_LAYERS_DIR=data/gis_layers
REPORTS_OUTPUT_DIR=data/reports

# --- Phase 3 / Member 3 External Service Credentials ---
